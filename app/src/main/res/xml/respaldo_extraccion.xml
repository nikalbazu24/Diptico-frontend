<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad de Android 12 o más nuevo: a la cuenta de Google y al pasar a un equipo nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="diptico.xml" />
        <include domain="file" path="notas/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="diptico.xml" />
        <include domain="file" path="notas/" />
    </device-transfer>
</data-extraction-rules>
