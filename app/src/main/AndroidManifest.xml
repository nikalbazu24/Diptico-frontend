    <application
        android:name=".DipticoApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/respaldo_reglas"
        android:dataExtractionRules="@xml/respaldo_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diptico">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InferiorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="cl.nikalbazu.diptico.inferior"
            android:windowSoftInputMode="adjustResize" />

        <!-- Inicio de la segunda pantalla: Android lo abre en la pantalla de abajo y trae a Díptico. -->
        <activity
            android:name=".InicioAbajo"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Bisa mientras juegas: aviso fijo y burbuja flotante encima del juego. -->
        <service
            android:name=".bisa.BurbujaBisa"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Asistente de juegos que se muestra como burbuja flotante mientras la persona juega" />
        </service>

        <service android:name=".retoma.RetomaServicio" android:exported="false" android:foregroundServiceType="mediaProjection" />

        <!-- Lupa: copia la pantalla de arriba para ampliar una parte en la de abajo. -->
        <service
            android:name=".lupa.LupaServicio"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".lupa.PermisoLupaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".bisa.AyudaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:label="Revisión de actualizaciones de Díptico"
            android:name=".estado.RevisionActualizaciones"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Respuesta de Android al instalar una actualización descargada desde Díptico. -->
        <receiver
            android:name=".estado.ReceptorInstalacion"
            android:exported="false" />

        <!-- Para el widget de música: ver y controlar lo que suena en Spotify, YouTube Music, etc. -->
        <service
            android:name=".audio.OyenteMedios"
            android:exported="false"
            android:label="Díptico · widget de música"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Kit de Discord: vuelve a Díptico después de «Autorizar». Sin el kit, esta pantalla no existe y nadie la abre. -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:node="merge"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${discordEsquema}" />
            </intent-filter>
        </activity>
        <!-- Díptico no hace llamadas de voz por Discord: fuera el servicio y los permisos que el kit trae para eso. -->
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
    </application>
</manifest>

