<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para descargar portadas, imágenes y títulos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Para que el centro de control muestre si el Wi-Fi y el Bluetooth están encendidos -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Modo turbo: dormir apps de fondo antes de jugar y "No molestar" mientras juegas -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Actualizaciones desde la misma app (Android pide confirmar cada instalación) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notas de voz: "¿dónde quedaste?" dicho en voz alta -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para encontrar los emuladores, ports y juegos de Android instalados (Díptico es un launcher) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Emuladores que Díptico sabe abrir (Android 11+ necesita declararlos para verlos) -->
    <queries>
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.explusalpha.Snes9xPlus" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="org.mupen64plusae.v3.fzurita" />
        <package android:name="org.mupen64plusae.v3.fzurita.amazon" />
        <package android:name="org.mupen64plusae.v3.alpha" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="it.dbtecno.pizzaboygbapro" />
        <package android:name="it.dbtecno.pizzaboygba" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.mmjr" />
        <package android:name="me.magnum.melonds" />
        <package android:name="me.magnum.melonds.nightly" />
        <package android:name="me.magnum.melondualds" />
        <package android:name="com.dsemu.drastic" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="com.armsx3" />
        <package android:name="com.armsx3.play" />
        <package android:name="aenu.aps3e" />
        <package android:name="aenu.aps3e.premium" />
        <package android:name="com.bachatas4.android" />
        <package android:name="com.bachatas4.android.github" />
        <!-- Dictado por voz (para Bisa y el teclado) -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Para elegir ports y apps que se pueden abrir -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".DipticoApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/respaldo_reglas"
        android:dataExtractionRules="@xml/respaldo_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diptico">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InferiorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="cl.nikalbazu.diptico.inferior"
            android:windowSoftInputMode="adjustResize" />

        <!-- Inicio de la segunda pantalla: Android lo abre en la pantalla de abajo y trae a Díptico. -->
        <activity
            android:name=".InicioAbajo"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Bisa mientras juegas: aviso fijo y burbuja flotante encima del juego. -->
        <service
            android:name=".bisa.BurbujaBisa"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Asistente de juegos que se muestra como burbuja flotante mientras la persona juega" />
        </service>

        <service android:name=".retoma.RetomaServicio" android:exported="false" android:foregroundServiceType="mediaProjection" />

        <!-- Lupa: copia la pantalla de arriba para ampliar una parte en la de abajo. -->
        <service
            android:name=".lupa.LupaServicio"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".lupa.PermisoLupaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".bisa.AyudaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Respuesta de Android al instalar una actualización descargada desde Díptico. -->
        <receiver
            android:name=".estado.ReceptorInstalacion"
            android:exported="false" />

        <!-- Para el widget de música: ver y controlar lo que suena en Spotify, YouTube Music, etc. -->
        <service
            android:name=".audio.OyenteMedios"
            android:exported="false"
            android:label="Díptico · widget de música"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>

